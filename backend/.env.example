DATABASE_URL="postgresql://user:password@localhost:5432/diane_frigo?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/diane_frigo?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Secret key required to trigger the daily demo reseed — sent as the
# X-Demo-Reseed-Key header, never as a URL query parameter.
DEMO_RESEED_KEY="replace-with-a-random-string"

# AI Assistant (Settings > Assistant) — FREE key created at
# https://aistudio.google.com/apikey (no credit card required).
# Never paste the real key here — this file is a template committed to
# the repo; the real value only goes in your local (never committed)
# .env file or in your hosting platform's environment variables.
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
